#!/usr/bin/env zsh
# Rebuild the dev binary when local main moves. Logic lives in scripts/rebuildDevBinary.go; this only filters and
# launches it detached, and always exits 0 so a ref update is never blocked.
[[ $1 == committed ]] || exit 0
while read -r old new ref; do
    if [[ $ref == refs/heads/main ]]; then
        dir=${0:h}
        # Installed copies sit next to the script; in the repo it's one level up.
        [[ -f $dir/rebuildDevBinary.go ]] || dir=$dir/..
        nohup $dir/rebuildDevBinary.go $new >/dev/null 2>&1 &
        break
    fi
done
exit 0
